---
/*
 * Hero de la portada [ref] — sigue a Hero.astro y a la home de Dong: titular
 * bold de 3xl a 6xl con interlineado y tracking ajustados, alineado a la izquierda en móvil y
 * centrado desde md, y una palabra dentro de una caja de selección con ocho tiradores que se
 * puede arrastrar (en Dong, "design"). Aquí la caja rodea "revisa": la revisión humana es lo que
 * define a Community IA. El icono que rebota también viene de Dong (animate-bounce).
 */
import { ArrowDown, Check, LogIn, Sparkles } from "lucide-react";
import GodRay from "@/components/ui/GodRay.astro";

const handles = [
  "top-0 left-0 -translate-x-1/2 -translate-y-1/2",
  "top-0 left-1/2 -translate-x-1/2 -translate-y-1/2",
  "top-0 right-0 translate-x-1/2 -translate-y-1/2",
  "top-1/2 left-0 -translate-x-1/2 -translate-y-1/2",
  "top-1/2 right-0 translate-x-1/2 -translate-y-1/2",
  "bottom-0 left-0 -translate-x-1/2 translate-y-1/2",
  "bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2",
  "bottom-0 right-0 translate-x-1/2 translate-y-1/2",
];
const boxClass =
  "inline-flex items-center gap-1 md:gap-2 border md:border-2 border-current/60 p-1 pr-2 whitespace-nowrap cursor-grab select-none transition hover:-rotate-2 hover:bg-brand-500/20 hover:text-brand-600";
// Los iconos son componentes React renderizados en el servidor: el estilo va como objeto.
const iconStyle = { width: "8vw", height: "8vw", maxWidth: 56, maxHeight: 56, minWidth: 28, minHeight: 28 };
const sparkleStyle = { width: "5vw", height: "5vw", maxWidth: 64, maxHeight: 64, minWidth: 32 };
---

<section id="inicio" class="hero relative isolate text-landing-ink text-left md:text-center">
  <GodRay origin="top-right" intensity={0.3} />

  <div class="mx-auto max-w-6xl px-6 pt-10 pb-20 md:pt-[calc(var(--landing-nav-height)+5rem)] md:pb-28 flex flex-col gap-12 md:gap-16">
    <div class="flex flex-col gap-5 md:items-center">
      <h1 class="text-[2.125rem] leading-[1.15] md:text-6xl md:leading-[1.2] font-bold tracking-tight">
        <span class="sr-only">Te damos la bienvenida a Community IA, donde tu equipo revisa lo que la IA propone.</span>
        <span aria-hidden="true" class="block">
          <span class="block text-lg md:text-2xl font-semibold tracking-normal opacity-70 mb-3">Te damos la bienvenida a</span>
          <span class="block">Community IA,</span>
          <span class="inline-flex flex-wrap items-baseline gap-x-3 md:justify-center">
            donde tu equipo
            <span class="relative inline-flex">
              <!-- Igual que en Dong: una copia invisible reserva el espacio y la real se arrastra encima -->
              <span class:list={[boxClass, "invisible"]}>
                <Check style={iconStyle} strokeWidth={2.25} />revisa
              </span>
              <span id="draggable-word" class:list={[boxClass, "absolute left-0 top-0"]}>
                <Check style={iconStyle} strokeWidth={2.25} />revisa
                {handles.map((pos) => <span class:list={["absolute size-1 md:size-2 bg-current/60", pos]} />)}
              </span>
            </span>
          </span>
          <span class="block">
            lo que la IA <em>propone</em><Sparkles
              className="hidden md:inline-block ml-3 align-baseline motion-safe:animate-bounce"
              style={sparkleStyle}
            />
          </span>
        </span>
      </h1>

      <p class="text-xl md:text-2xl font-medium max-w-[36ch] leading-snug md:mx-auto">
        Convierte las conversaciones de tu comunidad en contenido listo para publicar.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 md:justify-center">
      <a href="/login" class="btn-primary hero-cta">
        <LogIn className="w-5 h-5" aria-hidden="true" /> Iniciar sesión
      </a>
      <a href="#producto" class="hero-secondary">
        Descubrir Community IA <ArrowDown className="w-5 h-5" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero-cta {
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
  }
  /* Secundario [ref]: contorno primary/60 en píldora, como el buscador del hero de Dong. */
  .hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 70px;
    border: 1px solid rgb(139 96 255 / 0.6);
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-landing-ink);
    transition: background-color 150ms;
  }
  .hero-secondary:hover {
    background-color: rgb(139 96 255 / 0.1);
  }
  .hero-secondary:active {
    background-color: rgb(139 96 255 / 0.2);
  }
  #draggable-word.grabbing {
    cursor: grabbing;
    transform: rotate(-2deg);
    background-color: rgb(139 96 255 / 0.2);
    color: var(--color-brand-600);
  }
</style>

<script>
  // Arrastre de la caja de selección, adaptado del script de la home de Dong (ratón y táctil).
  const box = document.getElementById("draggable-word");
  if (box) {
    let offsetX = 0;
    let offsetY = 0;
    const point = (e: MouseEvent | TouchEvent) => ("touches" in e ? e.touches[0]! : e);

    const move = (e: MouseEvent | TouchEvent) => {
      e.preventDefault();
      const p = point(e);
      box.style.left = `${p.clientX - offsetX}px`;
      box.style.top = `${p.clientY - offsetY}px`;
    };
    const start = (e: MouseEvent | TouchEvent) => {
      e.preventDefault();
      const p = point(e);
      box.classList.add("grabbing");
      offsetX = p.clientX - box.offsetLeft;
      offsetY = p.clientY - box.offsetTop;
      window.addEventListener("mousemove", move);
      window.addEventListener("touchmove", move, { passive: false });
    };
    const end = () => {
      box.classList.remove("grabbing");
      window.removeEventListener("mousemove", move);
      window.removeEventListener("touchmove", move);
    };

    box.addEventListener("mousedown", start);
    box.addEventListener("touchstart", start, { passive: false });
    window.addEventListener("mouseup", end);
    window.addEventListener("touchend", end);
  }
</script>
