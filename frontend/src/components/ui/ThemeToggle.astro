---
/*
 * Botón de tema para las páginas Astro (portada y acceso). El clic y aria-pressed los gestiona
 * el script de BaseLayout por delegación, así que el mismo marcado sirve en la isla React.
 */
import { Moon, Sun } from "lucide-react";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button type="button" data-theme-toggle class:list={["theme-toggle", className]} aria-label="Modo oscuro" title="Cambiar tema">
  <Moon className="icon-moon w-5 h-5" aria-hidden="true" />
  <Sun className="icon-sun w-5 h-5" aria-hidden="true" />
</button>
