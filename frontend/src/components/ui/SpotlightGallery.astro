---
/*
 * Galería de tarjetas spotlight [ref] — port de SpotlightCardsGallery.astro de Dong: al mover el
 * puntero sobre la galería, todas las tarjetas visibles reciben su posición relativa, así el halo
 * se derrama también sobre los bordes de las tarjetas vecinas. Throttle de 10ms, como en Dong.
 */
interface Props {
  /** Columnas desde md (Dong usa una cuadrícula adaptable; aquí 2 para los pasos, 1 para un formulario). */
  columns?: 1 | 2;
  class?: string;
}
const { columns = 2, class: className } = Astro.props;
---

<div data-spotlight-gallery class:list={["grid grid-cols-1 gap-4", columns === 2 && "md:grid-cols-2", className]}>
  <slot />
</div>

<script>
  function throttle<T extends unknown[]>(fn: (...args: T) => void, wait: number) {
    let waiting = false;
    return (...args: T) => {
      if (waiting) return;
      fn(...args);
      waiting = true;
      setTimeout(() => (waiting = false), wait);
    };
  }

  function isVisible(el: HTMLElement) {
    const { top, bottom } = el.getBoundingClientRect();
    return (top > 0 && top < innerHeight) || (bottom > 0 && bottom < innerHeight);
  }

  document.querySelectorAll<HTMLElement>("[data-spotlight-gallery]").forEach((gallery) => {
    const cards = [...gallery.querySelectorAll<HTMLElement>(".spot-card")];
    gallery.addEventListener(
      "mousemove",
      throttle((e: MouseEvent) => {
        for (const card of cards) {
          if (!isVisible(card)) continue;
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
          card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
        }
      }, 10)
    );
  });
</script>
