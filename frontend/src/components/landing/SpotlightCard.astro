---
/*
 * Tarjeta spotlight [ref] — port de SpotlightCard.astro del tema Dong: borde de 2px teñido con el
 * color de la tarjeta, dos halos radiales que siguen al puntero (los coloca SpotlightGallery),
 * elevación de 4px al pasar el cursor con la curva cubic-bezier(.3,.7,.4,.1) y 34ms al pulsar.
 * Opcionalmente, una ficha con icono del color de la tarjeta (la de SpotlightPostCard de Dong),
 * colocada en una columna a la izquierda del contenido.
 */
interface Props {
  /** Color de la tarjeta en HEX (#rrggbb). */
  tone: string;
  /** false: sin elevación al pasar el cursor (p. ej. un formulario, para que no se mueva al escribir). */
  lift?: boolean;
  class?: string;
}

const { tone, lift = true, class: className } = Astro.props;
const rgba = (alpha: number) => {
  const n = Number.parseInt(tone.slice(1), 16);
  return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
};
const cardDefaultBorderColor = rgba(0.2);
const cardBorderColor = rgba(0.6);
const cardFillColor = rgba(1);
const cardShadowColor = rgba(0.1);
const cardHoverFillColor = rgba(0.1);
const cardHoverActiveColor = rgba(0.2);
const hasIcon = Astro.slots.has("icon");
---

<div class:list={["spot-card", !lift && "no-lift", className]}>
  <div class="spot-content">
    <div class:list={["spot-inner", hasIcon && "with-icon"]}>
      {
        hasIcon && (
          <div class="spot-icon" aria-hidden="true">
            <slot name="icon" />
          </div>
        )
      }
      <div class="spot-body">
        <slot />
      </div>
    </div>
  </div>
</div>

<style
  define:vars={{ cardDefaultBorderColor, cardBorderColor, cardFillColor, cardShadowColor, cardHoverFillColor, cardHoverActiveColor, tone }}
>
  .spot-card {
    --radius: 8px;
    --border-width: 2px;
    position: relative;
    z-index: 0;
    display: flex;
    border-radius: var(--radius);
    background-color: color-mix(in srgb, var(--cardDefaultBorderColor), black 5%);
    transition: transform 150ms cubic-bezier(0.3, 0.7, 0.4, 0.1);
  }
  .spot-card:hover {
    transform: translateY(-0.25rem);
    box-shadow: 0 0 30px 10px var(--cardShadowColor);
  }
  .spot-card.no-lift:hover {
    transform: none;
  }
  .spot-card:active {
    transform: translateY(0);
    transition-duration: 34ms;
  }

  .spot-card::before,
  .spot-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0.2;
    transition: opacity 500ms;
    pointer-events: none;
  }
  .spot-card::before {
    background: radial-gradient(800px circle at var(--mouse-x, -100%) var(--mouse-y, -100%), var(--cardFillColor), transparent 40%);
    z-index: 2;
  }
  .spot-card::after {
    background: radial-gradient(600px circle at var(--mouse-x, -100%) var(--mouse-y, -100%), var(--cardBorderColor), transparent 40%);
    z-index: 1;
  }
  .spot-card:hover::before {
    opacity: 1;
  }

  .spot-content {
    position: relative;
    z-index: 2;
    margin: var(--border-width);
    width: calc(100% - var(--border-width) * 2);
    border-radius: calc(var(--radius) - var(--border-width));
    background-color: color-mix(in srgb, var(--color-landing-bg) 70%, transparent); /* como bg-background/70 en Dong */
  }
  .spot-inner {
    height: 100%;
    padding: 1.5rem;
    border-radius: inherit;
    transition: background-color 150ms;
  }
  .spot-card:hover .spot-inner {
    background-color: var(--cardHoverFillColor);
  }
  .spot-card:active .spot-inner {
    background-color: var(--cardHoverActiveColor);
    transition-duration: 34ms;
  }

  .spot-inner.with-icon {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .spot-body {
    flex: 1;
    min-width: 0;
    height: 100%;
  }
  .spot-icon {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--tone);
    color: #000;
  }

  @media (max-width: 639px) {
    .spot-inner {
      padding: 1.25rem;
    }
    .spot-inner.with-icon {
      gap: 1rem;
    }
    .spot-icon {
      width: 3rem;
      height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spot-card,
    .spot-card::before,
    .spot-card::after {
      transition: none;
    }
    .spot-card:hover {
      transform: none;
    }
  }
</style>
