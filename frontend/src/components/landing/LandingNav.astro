---
/*
 * Navegación de la portada [ref] — sigue a GlobalNavbar.astro de Dong: en escritorio, barra fija
 * arriba, transparente con desenfoque y enlaces al 60% de opacidad que pasan al 100% al
 * señalarlos; en móvil, una píldora flotante abajo con icono y etiqueta, con la máscara en
 * degradado que usa Dong para que el contenido se funda por debajo.
 */
import { House, Info, LogIn, Workflow } from "lucide-react";
import ThemeToggle from "@/components/ThemeToggle.astro";

const links = [
  { href: "#producto", label: "Qué es", icon: Info },
  { href: "#como-funciona", label: "Cómo funciona", icon: Workflow },
];
---

<!-- Escritorio -->
<header class="landing-nav hidden md:block fixed top-0 inset-x-0 z-50 backdrop-blur">
  <div class="mx-auto max-w-6xl px-6 h-full flex items-center gap-8">
    <a href="#inicio" class="inline-flex items-center gap-2.5 font-bold text-lg text-landing-ink">
      <span class="brand-mark w-9 h-9" aria-hidden="true"></span>
      Community IA
    </a>
    <nav aria-label="Secciones de la portada">
      <ul class="flex items-center gap-2">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="nav-link px-4 py-2 font-medium text-landing-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle class="ml-auto" />
    <a href="/login" class="btn-primary -ml-4">
      <LogIn className="w-4 h-4" aria-hidden="true" /> Iniciar sesión
    </a>
  </div>
</header>

<!-- Móvil: marca arriba (sin fijar) y píldora de navegación abajo -->
<div class="md:hidden px-5 pt-5 flex items-center justify-between gap-4 text-landing-ink">
  <a href="#inicio" class="inline-flex items-center gap-2.5 font-bold text-lg">
    <span class="brand-mark w-8 h-8" aria-hidden="true"></span>
    Community IA
  </a>
  <ThemeToggle />
</div>
<nav aria-label="Navegación" class="landing-pill-wrap md:hidden fixed inset-x-0 bottom-4 z-50 px-4">
  <ul class="landing-pill mx-auto flex items-stretch justify-between gap-1 rounded-full px-3">
    <li>
      <a href="#inicio" class="pill-link">
        <House className="w-6 h-6" aria-hidden="true" />
        <span>Inicio</span>
      </a>
    </li>
    {
      links.map(({ href, label, icon: Icon }) => (
        <li>
          <a href={href} class="pill-link">
            <Icon className="w-6 h-6" aria-hidden="true" />
            <span>{label}</span>
          </a>
        </li>
      ))
    }
    <li>
      <a href="/login" class="pill-link pill-login">
        <LogIn className="w-6 h-6" aria-hidden="true" />
        <span>Entrar</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  .landing-nav {
    height: var(--landing-nav-height);
  }
  .nav-link {
    display: inline-block;
    border-radius: 9999px;
    opacity: 0.6;
    transition: opacity 150ms;
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    opacity: 1;
  }

  .landing-pill-wrap {
    padding-bottom: env(safe-area-inset-bottom);
  }
  .landing-pill {
    height: var(--landing-nav-height);
    max-width: 26rem;
    background-color: var(--color-landing-bg);
    color: var(--color-landing-ink);
    box-shadow:
      0 10px 15px -3px color-mix(in srgb, var(--color-landing-ink) 12%, transparent),
      0 4px 6px -4px color-mix(in srgb, var(--color-landing-ink) 12%, transparent);
  }
  .landing-pill li {
    flex: 1;
    display: flex;
  }
  .pill-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    padding: 0.5rem 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    color: inherit;
    opacity: 0.6;
    transition: opacity 150ms;
  }
  .pill-link:hover,
  .pill-link:focus-visible {
    opacity: 1;
  }
  .pill-login {
    opacity: 1;
    color: var(--color-brand-600);
  }
</style>
