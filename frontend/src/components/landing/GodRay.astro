---
/*
 * Fondo de rayos de luz [ref] — adaptación de GodRay.astro del tema Dong: rayas blancas y un
 * arcoíris en el mismo ángulo, invertidos y desenfocados, recortados con una máscara radial y
 * desplazados en bucle. Dong elige colores al azar en cada build; aquí son fijos y salen de la
 * paleta de Community IA para que la portada no cambie entre despliegues.
 * El estilo está en global.css (.godray) porque la sidebar de la app lo reutiliza.
 * Añadido propio: con prefers-reduced-motion los rayos quedan quietos.
 */
interface Props {
  /** Esquina desde la que nacen los rayos (Dong: arriba a la derecha). */
  origin?: "top-right" | "top-left" | "bottom-left";
  /** Intensidad del efecto (Dong usa 0.3). */
  intensity?: number;
}

const { origin = "top-right", intensity = 0.3 } = Astro.props;
const mask = { "top-right": "100% 0", "top-left": "0 0", "bottom-left": "0 100%" }[origin];
---

<div class="godray-frame" aria-hidden="true">
  <div class="godray" style={`opacity: ${intensity}; --godray-mask: ${mask}`}></div>
</div>
