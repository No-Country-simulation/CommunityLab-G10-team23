---
import "@fontsource-variable/work-sans";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Community IA - Hub de Distribución y Análisis",
  description = "Revisión humana del contenido que genera el pipeline de Community IA",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08002e" />
    <script is:inline>
      // Tema antes del primer pintado para evitar el destello claro. Sin elección guardada se
      // sigue al sistema (y a sus cambios); el botón [data-theme-toggle] guarda la elección.
      (() => {
        const root = document.documentElement;
        const media = matchMedia("(prefers-color-scheme: dark)");
        const stored = () => {
          try {
            return localStorage.getItem("theme");
          } catch {
            return null;
          }
        };
        const apply = (theme) => {
          root.dataset.theme = theme;
          for (const btn of document.querySelectorAll("[data-theme-toggle]")) {
            btn.setAttribute("aria-pressed", String(theme === "dark"));
          }
        };
        apply(stored() ?? (media.matches ? "dark" : "light"));
        media.addEventListener("change", (e) => {
          if (!stored()) apply(e.matches ? "dark" : "light");
        });
        document.addEventListener("DOMContentLoaded", () => apply(root.dataset.theme));
        document.addEventListener("click", (e) => {
          if (!(e.target instanceof Element) || !e.target.closest("[data-theme-toggle]")) return;
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem("theme", next);
          } catch {}
          apply(next);
        });
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
