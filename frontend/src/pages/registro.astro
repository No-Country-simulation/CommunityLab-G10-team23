---
import AuthLayout from "@/layouts/AuthLayout.astro";
---

<AuthLayout
  title="Crear cuenta"
  heading="Crea tu cuenta"
  intro="Te invitaron a Community IA. Elige el nombre que verá tu equipo y una contraseña."
>
  <meta name="referrer" content="no-referrer" slot="head" />
  <form id="registro-form" class="flex flex-col gap-5" novalidate>
    <p data-alert class="auth-alert" role="alert" hidden></p>

    <div class="auth-field">
      <label for="nombre">Nombre</label>
      <input id="nombre" name="nombre" type="text" autocomplete="name" maxlength="120" required autofocus />
    </div>
    <div class="auth-field">
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="password-hint" />
      <span id="password-hint" class="hint">Al menos 12 caracteres. Una frase fácil de recordar funciona bien.</span>
    </div>
    <div class="auth-field">
      <label for="confirmar">Repite la contraseña</label>
      <input id="confirmar" name="confirmar" type="password" autocomplete="new-password" required />
    </div>

    <button type="submit" class="btn-primary w-full py-3" data-busy="Creando cuenta…">Crear cuenta</button>
  </form>
</AuthLayout>

<script>
  import { bindAuthForm, checkNewPassword, showAlert, takeToken } from "@/lib/authForm";

  const form = document.querySelector<HTMLFormElement>("#registro-form")!;
  const token = takeToken();
  if (!token) {
    showAlert(form, "Este enlace no es válido. Pide a quien administra Community IA una invitación nueva.");
    form.querySelector<HTMLButtonElement>("button[type=submit]")!.disabled = true;
  }

  bindAuthForm(form, {
    endpoint: "/api/auth/registro",
    build: (data) => {
      const nombre = String(data.get("nombre") ?? "").trim();
      if (!nombre) return "Escribe tu nombre.";
      const problem = checkNewPassword(data);
      if (problem) return problem;
      return { token: token ?? "", nombre, password: String(data.get("password")) };
    },
    onSuccess: () => window.location.assign("/"),
  });
</script>
