# Copia este archivo como .env y coloca aqui tus credenciales locales.
# Nunca subas .env al repositorio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Solo en la VM del frontend: IP privada del backend dentro de la VCN.
# BACKEND_URL=http://10.0.0.X:8000
# Solo en la VM del frontend, detrás de un proxy HTTPS propio (Caddy, load balancer):
# COOKIE_SECURE=true
# TRUST_PROXY=true
# Nunca en producción: sin inicio de sesión y con datos simulados.
# DEMO_MODE=false

# Opcional: carpeta con las credenciales de OCI (por defecto /home/opc/.oci).
# OCI_CONFIG_DIR=/home/opc/.oci
