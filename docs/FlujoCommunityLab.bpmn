<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_communitylab" targetNamespace="http://communitylab/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="pool" name="CommunityLab" processRef="proc_lote" />
    <bpmn:textAnnotation id="a_items">
      <bpmn:text>Los errores se guardan en el campo error del ítem; el lote continúa con la siguiente interacción.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="a_conf">
      <bpmn:text>El LLM propone; el umbral 0.75 decide si se le cree.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="a_fallido">
      <bpmn:text>Fallo fuera de los ítems (p. ej. falta GEMINI_API_KEY antes del bucle): cae el lote entero.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_fallido_assoc" sourceRef="a_fallido" targetRef="end_fallido" />
    <bpmn:textAnnotation id="a_polling">
      <bpmn:text>Los candidatos aparecen en la bandeja a medida que cada interacción termina.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="a_revisar">
      <bpmn:text>Sin vencimiento: un candidato puede quedar pendiente indefinidamente, y uno rechazado puede volver a aprobado (el PATCH no lo restringe). Mientras que no se hayan guardado los cambios, los estados pueden ser modificados.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_revisar_assoc" sourceRef="a_revisar" targetRef="t_revisar" />
    <bpmn:textAnnotation id="a_publicar">
      <bpmn:text>Solo se guarda si no quedan pendientes. Se envían los ítems revisados y se respeta la decisión humana (aprobado / rechazado).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_publicar_assoc" sourceRef="a_publicar" targetRef="t_publicar" />
    <bpmn:textAnnotation id="a_espera">
      <bpmn:text>Se omite en la primera interacción.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_espera_assoc" sourceRef="a_espera" targetRef="s_espera" />
    <bpmn:textAnnotation id="a_429">
      <bpmn:text>Llamadas al LLM (✦): si Gemini responde 429, espera 4.5 s y reintenta una vez.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="a_desc">
      <bpmn:text>En la interfaz aparece bajo el filtro «Descartadas»; no es un estado del backend.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_desc_assoc" sourceRef="a_desc" targetRef="end_desc" />
    <bpmn:textAnnotation id="a_paquete">
      <bpmn:text>El paquete guardado incluye resumen de comunidad, activos ganadores y todos los casos revisados.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_paquete_assoc" sourceRef="a_paquete" targetRef="end_pub" />
  </bpmn:collaboration>
  <bpmn:process id="proc_lote" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_D" name="Publicación OCI e Historial">
        <bpmn:flowNodeRef>t_seleccionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resumen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_subir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_numerar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_C" name="Agente Redactor" />
      <bpmn:lane id="lane_B" name="Agente Clasificador">
        <bpmn:flowNodeRef>sub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_A" name="Agente Analista">
        <bpmn:flowNodeRef>b_sub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ORQ" name="Orquestador de trabajos">
        <bpmn:flowNodeRef>t_crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_iniciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fallido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_fallido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_completar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_completado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_FE" name="Frontend">
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_estado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_conexion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_listar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dashboard</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_CM" name="Community Manager">
        <bpmn:flowNodeRef>start_lote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cargar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_hist</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_lote" name="Lote recibido">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_cargar" name="Cargar lote (JSON o demo)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_crear" name="Crear trabajo [en_cola]">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="gw_par">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="t_iniciar" name="Iniciar procesamiento [en_proceso]">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_fallido" name="Marcar trabajo [fallido]">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_fallido" name="Trabajo fallido">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:errorEventDefinition id="end_fallido_def" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_completar" name="Marcar trabajo [completado]">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_completado" name="Trabajo completado">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="timer" name="Cada 2 s">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_def">
        <bpmn:timeDuration>PT2S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="gw_estado" name="¿Estado del trabajo?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="t_seleccionar" name="Elegir mejor aprobado por tipo (mayor relevance_score)">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="t_resumen" name="Calcular resumen de comunidad">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="t_subir" name="Subir activos/paquete_{N}/paquete-distribucion.json">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da_bucket">
        <bpmn:targetRef>store_bucket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="end_pub" name="Paquete guardado [guardado_con_exito]">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_conexion" name="Seguimiento detenido [fallido]">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:errorEventDefinition id="end_conexion_def" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_consultar" name="Consultar avance del trabajo (?desde=n)">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_revisar" name="Revisar candidato (aprobar, editar o rechazar)">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da_revisar">
        <bpmn:targetRef>store_activos_rev</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="t_publicar" name="Guardar cambios en OCI">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="store_bucket" name="Bucket OCI" />
    <bpmn:subProcess id="sub" name="Procesar interacción (secuencial, una a la vez)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics id="sub_mi" isSequential="true" />
      <bpmn:startEvent id="s_start" name="Interacción del lote">
        <bpmn:outgoing>s1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:intermediateCatchEvent id="s_espera" name="Esperar 3 s (límite 15 RPM)">
        <bpmn:incoming>s1</bpmn:incoming>
        <bpmn:outgoing>s24</bpmn:outgoing>
        <bpmn:timerEventDefinition id="s_espera_def">
          <bpmn:timeDuration>PT3S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="s_crear" name="Crear InteraccionInterna (el campo tipo se ignora)">
        <bpmn:incoming>s24</bpmn:incoming>
        <bpmn:outgoing>s2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="s_analizar" name="✦ LLM · Analizar interacción">
        <bpmn:incoming>s2</bpmn:incoming>
        <bpmn:outgoing>s3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="b_analizar" name="Fallo tras reintentos (incl. 429)" attachedToRef="s_analizar">
        <bpmn:outgoing>s4</bpmn:outgoing>
        <bpmn:errorEventDefinition id="b_analizar_def" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="s_neutral" name="Usar análisis neutral [degradado = true]">
        <bpmn:incoming>s4</bpmn:incoming>
        <bpmn:outgoing>s5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="s_clasificar" name="✦ LLM · Clasificar categoría y confianza">
        <bpmn:incoming>s3</bpmn:incoming>
        <bpmn:incoming>s5</bpmn:incoming>
        <bpmn:incoming>s9</bpmn:incoming>
        <bpmn:outgoing>s6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="g_prop" name="¿Hay propuesta?">
        <bpmn:incoming>s6</bpmn:incoming>
        <bpmn:outgoing>s7</bpmn:outgoing>
        <bpmn:outgoing>s8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="g_int" name="¿Intentos &#60; 2?">
        <bpmn:incoming>s8</bpmn:incoming>
        <bpmn:outgoing>s9</bpmn:outgoing>
        <bpmn:outgoing>s10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="s_reglas" name="Clasificación por reglas (confianza 0.0)">
        <bpmn:incoming>s10</bpmn:incoming>
        <bpmn:outgoing>s11</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="g_conf" name="¿Confianza ≥ 0.75?">
        <bpmn:incoming>s7</bpmn:incoming>
        <bpmn:outgoing>s12</bpmn:outgoing>
        <bpmn:outgoing>s13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:businessRuleTask id="s_reemplazar" name="Reemplazar categoría por la de reglas">
        <bpmn:incoming>s13</bpmn:incoming>
        <bpmn:outgoing>s14</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="s_score" name="Calcular relevance_score (0–100)">
        <bpmn:incoming>s11</bpmn:incoming>
        <bpmn:incoming>s12</bpmn:incoming>
        <bpmn:incoming>s14</bpmn:incoming>
        <bpmn:outgoing>s15</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="g_ruta" name="¿Ruta?">
        <bpmn:incoming>s15</bpmn:incoming>
        <bpmn:outgoing>s16</bpmn:outgoing>
        <bpmn:outgoing>s17</bpmn:outgoing>
        <bpmn:outgoing>s18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="end_desc" name="Interacción descartada">
        <bpmn:incoming>s16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="end_alerta" name="Alerta de soporte (sin activos)">
        <bpmn:incoming>s17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:businessRuleTask id="s_formatos" name="Elegir formatos">
        <bpmn:incoming>s18</bpmn:incoming>
        <bpmn:outgoing>s19</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:serviceTask id="s_redactar" name="✦ LLM · Redactar activos">
        <bpmn:incoming>s19</bpmn:incoming>
        <bpmn:outgoing>s20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="b_redactar" name="Fallo o sin API key" attachedToRef="s_redactar">
        <bpmn:outgoing>s21</bpmn:outgoing>
        <bpmn:errorEventDefinition id="b_redactar_def" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="s_plantilla" name="Generar desde plantilla">
        <bpmn:incoming>s21</bpmn:incoming>
        <bpmn:outgoing>s22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="s_guardar" name="Guardar candidatos [pendiente]">
        <bpmn:incoming>s20</bpmn:incoming>
        <bpmn:incoming>s22</bpmn:incoming>
        <bpmn:outgoing>s23</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="da_activos">
          <bpmn:targetRef>store_activos</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:endEvent id="s_end" name="Candidatos listos para revisión">
        <bpmn:incoming>s23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataStoreReference id="store_activos" name="activos_candidatos.json" />
      <bpmn:sequenceFlow id="s1" sourceRef="s_start" targetRef="s_espera" />
      <bpmn:sequenceFlow id="s2" sourceRef="s_crear" targetRef="s_analizar" />
      <bpmn:sequenceFlow id="s3" name="AnalisisInterno" sourceRef="s_analizar" targetRef="s_clasificar" />
      <bpmn:sequenceFlow id="s4" sourceRef="b_analizar" targetRef="s_neutral" />
      <bpmn:sequenceFlow id="s5" sourceRef="s_neutral" targetRef="s_clasificar" />
      <bpmn:sequenceFlow id="s6" sourceRef="s_clasificar" targetRef="g_prop" />
      <bpmn:sequenceFlow id="s7" name="sí" sourceRef="g_prop" targetRef="g_conf" />
      <bpmn:sequenceFlow id="s8" name="no" sourceRef="g_prop" targetRef="g_int" />
      <bpmn:sequenceFlow id="s9" name="sí, reintentar" sourceRef="g_int" targetRef="s_clasificar" />
      <bpmn:sequenceFlow id="s10" name="no" sourceRef="g_int" targetRef="s_reglas" />
      <bpmn:sequenceFlow id="s11" sourceRef="s_reglas" targetRef="s_score" />
      <bpmn:sequenceFlow id="s12" name="sí" sourceRef="g_conf" targetRef="s_score" />
      <bpmn:sequenceFlow id="s13" name="no" sourceRef="g_conf" targetRef="s_reemplazar" />
      <bpmn:sequenceFlow id="s14" sourceRef="s_reemplazar" targetRef="s_score" />
      <bpmn:sequenceFlow id="s15" sourceRef="s_score" targetRef="g_ruta" />
      <bpmn:sequenceFlow id="s16" name="descartar" sourceRef="g_ruta" targetRef="end_desc" />
      <bpmn:sequenceFlow id="s17" name="revisión prioritaria" sourceRef="g_ruta" targetRef="end_alerta" />
      <bpmn:sequenceFlow id="s18" name="generar activos" sourceRef="g_ruta" targetRef="s_formatos" />
      <bpmn:sequenceFlow id="s19" sourceRef="s_formatos" targetRef="s_redactar" />
      <bpmn:sequenceFlow id="s20" name="Contenido generado" sourceRef="s_redactar" targetRef="s_guardar" />
      <bpmn:sequenceFlow id="s21" sourceRef="b_redactar" targetRef="s_plantilla" />
      <bpmn:sequenceFlow id="s22" sourceRef="s_plantilla" targetRef="s_guardar" />
      <bpmn:sequenceFlow id="s23" sourceRef="s_guardar" targetRef="s_end" />
      <bpmn:sequenceFlow id="s24" sourceRef="s_espera" targetRef="s_crear" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_sub" name="Fallo del lote" attachedToRef="sub">
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="b_sub_def" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start_lote" targetRef="t_cargar" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_cargar" targetRef="t_crear" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_crear" targetRef="gw_par" />
    <bpmn:sequenceFlow id="f4" sourceRef="gw_par" targetRef="t_iniciar" />
    <bpmn:sequenceFlow id="f5" sourceRef="gw_par" targetRef="timer" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_iniciar" targetRef="sub" />
    <bpmn:sequenceFlow id="f9" sourceRef="b_sub" targetRef="t_fallido" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_fallido" targetRef="end_fallido" />
    <bpmn:sequenceFlow id="f7" sourceRef="sub" targetRef="t_completar" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_completar" targetRef="end_completado" />
    <bpmn:sequenceFlow id="f13" name="en_cola / en_proceso" sourceRef="gw_estado" targetRef="timer" />
    <bpmn:sequenceFlow id="f11" sourceRef="timer" targetRef="t_consultar" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_consultar" targetRef="gw_estado" />
    <bpmn:sequenceFlow id="f14" name="fallido o 5 fallos seguidos" sourceRef="gw_estado" targetRef="end_conexion" />
    <bpmn:sequenceFlow id="f15" name="completado" sourceRef="gw_estado" targetRef="t_revisar" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_seleccionar" targetRef="t_resumen" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_numerar" targetRef="t_subir" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_subir" targetRef="end_pub" />
    <bpmn:sequenceFlow id="f16" name="Guardar cambios" sourceRef="t_revisar" targetRef="t_publicar" />
    <bpmn:dataStoreReference id="store_activos_rev" name="activos_candidatos.json (PATCH por decisión)" />
    <bpmn:exclusiveGateway id="g_pend" name="¿Hay candidatos pendientes?">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_alerta" name="Mostrar alerta: aprobar o rechazar todos">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_enviar" name="Enviar lote revisado (POST /storage/publish con items)">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f23" sourceRef="t_publicar" targetRef="g_pend" />
    <bpmn:sequenceFlow id="f24" name="sí" sourceRef="g_pend" targetRef="t_alerta" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_alerta" targetRef="t_revisar" />
    <bpmn:sequenceFlow id="f26" name="no" sourceRef="g_pend" targetRef="t_enviar" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_enviar" targetRef="t_seleccionar" />
    <bpmn:businessRuleTask id="t_numerar" name="Asignar número de paquete (Paquete N = existentes + 1)">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:property id="t_numerar_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_bucket_num">
        <bpmn:sourceRef>store_bucket</bpmn:sourceRef>
        <bpmn:targetRef>t_numerar_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="f31" sourceRef="t_resumen" targetRef="t_numerar" />
    <bpmn:serviceTask id="t_listar" name="Abrir Historial: listar paquetes (GET /storage/packages)">
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
      <bpmn:property id="t_listar_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="di_bucket_hist">
        <bpmn:sourceRef>store_bucket_hist</bpmn:sourceRef>
        <bpmn:targetRef>t_listar_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_dashboard" name="Mostrar dashboard (4 KPIs + 4 gráficas)">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_ver" name="Consultar paquete / Ver activo (solo lectura)">
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_hist" name="Paquete consultado">
      <bpmn:incoming>f35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="store_bucket_hist" name="Bucket OCI" />
    <bpmn:sequenceFlow id="f32" sourceRef="end_pub" targetRef="t_listar" />
    <bpmn:sequenceFlow id="f33" sourceRef="t_listar" targetRef="t_dashboard" />
    <bpmn:sequenceFlow id="f34" sourceRef="t_dashboard" targetRef="t_ver" />
    <bpmn:sequenceFlow id="f35" sourceRef="t_ver" targetRef="end_hist" />
  </bpmn:process>
